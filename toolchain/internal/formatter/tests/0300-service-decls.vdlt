@httpRpc type service{  @proc user_updates {
input { user_id string }
output { event_name string  created_at datetime[] }
}

@proc heartbeat { output { ok bool }}
}

// >>>>

@httpRpc
type Service {
  @proc
  userUpdates {
    input {
      userId string
    }
    output {
      eventName string
      createdAt datetime[]
    }
  }

  @proc
  heartbeat {
    output {
      ok bool
    }
  }
}
